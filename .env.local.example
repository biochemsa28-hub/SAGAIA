# ============================================================
# VYNAVO — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ----- APP -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="VYNAVO"
NODE_ENV=development

# ----- AI PROVIDERS -----
# OpenAI (required for production, mock used if missing)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic Claude (optional, future adapter)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- VOICE -----
# ElevenLabs (optional, mock used if missing)
ELEVENLABS_API_KEY=...
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel

# ----- DATABASE -----
# Phase 1: SQLite local file
DATABASE_PATH=./db/VYNAVO.db

# Phase 2: Cloudflare D1 (leave empty for local dev)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# ----- STORAGE -----
# Phase 1: Local filesystem
STORAGE_PATH=./storage

# Phase 2: Cloudflare R2 (leave empty for local dev)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=VYNAVO-assets

# ----- AUTH -----
# Phase 1: Simple JWT (next-auth with credentials)
NEXTAUTH_SECRET=change-me-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Phase 2: Clerk (optional upgrade)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ----- IMAGE QUALITY -----
# FLUX_QUALITY: "cinematic" (flux/dev, 28 steps — default, best) | "fast" (schnell, cheap)
FLUX_QUALITY=cinematic

# REALISM LoRA layer — makes images photorealistic (kills the plastic AI look).
# RECOMMENDED for a commercial product: MIT-licensed face/portrait realism LoRA.
# (Avoid XLabs flux-RealismLora — it's NON-COMMERCIAL licensed.)
# To activate, uncomment the line below. Empty = off. A bad URL degrades to flux/dev.
# FLUX_REALISM_LORA=https://huggingface.co/strangerzonehf/Flux-Super-Realism-LoRA/resolve/main/super-realism.safetensors
FLUX_REALISM_LORA=
FLUX_REALISM_SCALE=0.9
# Trigger word that activates the LoRA's trained style (for the LoRA above use "Super Realism").
FLUX_REALISM_TRIGGER=Super Realism

# ----- CHARACTER CONSISTENCY -----
# Scene 1 is generated first as a reference; scenes 2+ reuse it to keep the same
# person. CHARACTER_CONSISTENCY=off disables it. CHARACTER_REF_MODEL overrides the
# image-edit model (default fal-ai/nano-banana/edit — best character consistency).
CHARACTER_CONSISTENCY=on
# CHARACTER_REF_MODEL=fal-ai/nano-banana/edit
# Model that generates the 4 character options from a text description:
# CHARACTER_GEN_MODEL=fal-ai/nano-banana

# ----- ANIMATION TIER -----
# kenburns  = animate static images (cheap, default)
# cinematic = real AI video motion (Seedance)
# talking   = lip-sync: the character's mouth moves with the narration (VEED Fabric)
ANIMATION_TIER=kenburns
# Premium video model used when ANIMATION_TIER=cinematic (Seedance Pro by default).
# VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro/image-to-video
# Lip-sync model used when ANIMATION_TIER=talking (VEED Fabric by default).
# Swap to a MORE EXPRESSIVE model for "pro" talking heads — the input shape adapts
# automatically. Hedra Character-3 = caras que gesticulan y hablan con emoción.
# LIPSYNC_MODEL=veed/fabric-1.0
# LIPSYNC_MODEL=fal-ai/hedra/character-3   # más pro (gestos + expresión), valida con créditos
VIDEO_RESOLUTION=720p

# ----- PRO PIPELINE (Seedance motion → video lip-sync) -----
# When ON, each talking scene runs: image → Seedance (cinematic motion) →
# video lip-sync (sync.so) → final clip with REAL motion AND a synced mouth.
# Doubles cost + time per scene. Validate with credits before enabling.
# PRO_PIPELINE=on
# VIDEO_LIPSYNC_MODEL=fal-ai/sync-lipsync

# ----- AUTO SOUND EFFECTS -----
# Generate whoosh + niche-flavoured impact via ElevenLabs (on by default). off to disable.
AUTO_SFX=on

# ----- AUTO MUSIC (ElevenLabs Music) -----
# Compose an original background score matching the niche + mood. OPT-IN (off by
# default) because the ElevenLabs Music API needs a PAID plan (free → 402).
# Set to on only when your ElevenLabs plan includes Music.
# AUTO_MUSIC=on

# ----- MOCK MODE -----
# Force mock adapters regardless of API key presence
# Useful for development without spending credits
FORCE_MOCK_AI=false
FORCE_MOCK_VOICE=false
