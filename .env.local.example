# ============================================================
# SAGAIA — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ----- APP -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SAGAIA"
NODE_ENV=development

# ----- AI PROVIDERS -----
# OpenAI (required for production, mock used if missing)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic Claude (optional, future adapter)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- VOICE -----
# ElevenLabs (optional, mock used if missing)
ELEVENLABS_API_KEY=...
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel

# ----- DATABASE -----
# Phase 1: SQLite local file
DATABASE_PATH=./db/SAGAIA.db

# Phase 2: Cloudflare D1 (leave empty for local dev)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# ----- STORAGE -----
# Phase 1: Local filesystem
STORAGE_PATH=./storage

# Phase 2: Cloudflare R2 (leave empty for local dev)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=SAGAIA-assets

# ----- AUTH -----
# Phase 1: Simple JWT (next-auth with credentials)
NEXTAUTH_SECRET=change-me-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Phase 2: Clerk (optional upgrade)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ----- MOCK MODE -----
# Force mock adapters regardless of API key presence
# Useful for development without spending credits
FORCE_MOCK_AI=false
FORCE_MOCK_VOICE=false
