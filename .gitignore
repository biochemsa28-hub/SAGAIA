# dependencies
node_modules/
.pnp
.pnp.js

# production build
.next/
out/

# environment secrets — NEVER commit
.env
.env.local
.env.*.local
.env.production

# local database & generated audio
db/*.db
db/*.db-shm
db/*.db-wal
# Carpeta temporal de runtime en la raíz. SIN la barra inicial esta regla también
# tapaba services/storage/ — código fuente — y el build fallaba en cualquier
# checkout limpio con "Can't resolve @/services/storage", mientras en local
# compilaba perfecto porque el archivo sí existía en disco.
/storage/
!/services/storage/

# OS
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
