{
  "functions": {
    "app/api/generate/story/route.ts": { "maxDuration": 60 },
    "app/api/voice/route.ts":          { "maxDuration": 120 },
    "app/api/images/route.ts":         { "maxDuration": 120 },
    "app/api/videos/route.ts":         { "maxDuration": 300 },
    "app/api/export/[id]/route.ts":    { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
